# Food AI For Gym Members — Python Environment
# Copy file này thành .env và điền giá trị

# URL của Laravel API (Python gọi để lấy food data / rating matrix)
LARAVEL_API_URL=http://localhost:8000/api

# Internal API token (Laravel → Python, đặt giống PYTHON_INTERNAL_TOKEN trong Laravel .env)
LARAVEL_INTERNAL_TOKEN=change_me_in_production

# Port FastAPI chạy
PORT=8001

# CORS — danh sách origin được phép, cách nhau dấu phẩy
ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:3000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
